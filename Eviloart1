local U = {}

-- Рейкаст вниз: ищем пол под точкой. Возвращает безопасную позицию + hit.
function U.raycastGround(pos, ignore)
    local ig = ignore or (LP.Character and {LP.Character} or {})
    local ray = Ray.new(pos + Vector3.new(0, 120, 0), Vector3.new(0, -400, 0))
    local hit, hitPos, hitNormal = workspace:FindPartOnRayWithIgnoreList(ray, ig)
    if hit then
        return hitPos + Vector3.new(0, 3, 0), hitPos, hitNormal
    end
    return pos, pos, Vector3.new(0, 1, 0)
end

-- Универсальный рейкаст
function U.raycast(origin, direction, ignore)
    local ig = ignore or (LP.Character and {LP.Character} or {})
    local ray = Ray.new(origin, direction)
    local hit, hitPos, hitNormal = workspace:FindPartOnRayWithIgnoreList(ray, ig)
    return hit, hitPos, hitNormal
end

-- ПРАВИЛЬНЫЙ ТП ВПЕРЁД: идём от HRP, а не от камеры.
-- Делаем серию рейкастов, чтобы найти безопасную точку и не провалиться.
function U.teleportForward(studs)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local look = camera.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.1 then flatLook = Vector3.new(0, 0, -1) end
    flatLook = flatLook.Unit

    local startPos = hrp.CFrame.Position
    local targetPos = startPos + flatLook * studs

    -- Рейкаст от целевой точки вниз — ищем пол
    local safe, hitPos, hitNormal = U.raycastGround(targetPos)

    -- Проверяем, что между start и target нет стены (горизонтальный рейкаст)
    local hRay = Ray.new(startPos + Vector3.new(0, 2, 0), flatLook * studs)
    local hHit, hHitPos, hHitNormal = workspace:FindPartOnRayWithIgnoreList(hRay, {char})

    if hHit and (hHitPos - startPos).Magnitude < studs - 1 then
        -- стена: ставим игрока чуть раньше стены
        local wallDist = (hHitPos - startPos).Magnitude - 2
        if wallDist < 1 then wallDist = 1 end
        local wallPos = startPos + flatLook * wallDist
        local wSafe = U.raycastGround(wallPos)
        return wSafe
    end

    return safe
end

-- Эффект телепорта
function U.teleportEffect(pos, color, size)
    color = color or Color3.fromRGB(255, 220, 0)
    size  = size or 15

    local ball = Instance.new("Part")
    ball.Name = "EvilTeleportFX"
    ball.Size = Vector3.new(1, 1, 1)
    ball.Shape = Enum.PartType.Ball
    ball.Color = color
    ball.Material = Enum.Material.Neon
    ball.Anchored = true
    ball.CanCollide = false
    ball.CanQuery = false
    ball.CanTouch = false
    ball.CFrame = CFrame.new(pos)
    ball.Parent = workspace

    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = 10
    light.Range = size * 1.5
    light.Shadows = false
    light.Parent = ball

    local attach = Instance.new("Attachment")
    attach.Parent = ball

    local emit = Instance.new("ParticleEmitter")
    emit.Name = "TeleportParticles"
    emit.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emit.Color = ColorSequence.new(color)
    emit.Rate = 200
    emit.Lifetime = NumberRange.new(0.5, 1)
    emit.Speed = NumberRange.new(3, 8)
    emit.Size = NumberSequence.new(0.5)
    emit.LightEmission = 1
    emit.Parent = attach

    TweenService:Create(ball, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
        Size = Vector3.new(size, size, size),
        Transparency = 1
    }):Play()
    task.delay(0.6, function() if ball and ball.Parent then ball:Destroy() end end)
end

-- Звук телепорта
function U.teleportSound(parent)
    parent = parent or (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"))
    if not parent then return end
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://9114380053"
    s.Volume = 2
    s.Parent = parent
    s:Play()
    task.delay(2, function() if s and s.Parent then s:Destroy() end end)
end

-- Кнопка в меню
function U.makeButton(parent, text, yOffset, callback, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 44)
    btn.Position = UDim2.new(0.05, 0, 0, yOffset)
    btn.BackgroundColor3 = color or Color3.fromRGB(45, 45, 45)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 15
    btn.Text = text
    btn.AutoButtonColor = true
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    btn.MouseButton1Click:Connect(function()
        pcall(callback, btn)
    end)
    return btn
end

-- Плавающая кнопка
function U.makeFloatingButton(parent, text, size, pos, color, callback, draggable)
    local btn = Instance.new("TextButton")
    btn.Size = size or UDim2.new(0, 70, 0, 70)
    btn.Position = pos or UDim2.new(0, 10, 0, 130)
    btn.BackgroundColor3 = color or Color3.fromRGB(255, 200, 0)
    btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    btn.Text = text
    btn.Draggable = draggable or false
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = btn

    btn.MouseButton1Click:Connect(function()
        pcall(callback)
    end)
    return btn
end

function U.getHRP(plr)
    plr = plr or LP
    local char = plr.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

-- Проверка: тап по GUI или по миру
function U.isTapOnGUI(x, y)
    local gui = CTX.gui
    if not gui then return false end
    local objs = LP.PlayerGui:GetGuiObjectsAtPosition(x, y)
    for _, g in pairs(objs) do
        if g:IsDescendantOf(gui) then return true end
    end
    return false
end


local U={}

function U.rayGround(pos,ig)
    ig=ig or (LP.Character and {LP.Character} or {})
    local r=Ray.new(pos+Vector3.new(0,120,0),Vector3.new(0,-400,0))
    local h,hp,hn=workspace:FindPartOnRayWithIgnoreList(r,ig)
    if h then return hp+Vector3.new(0,3,0),hp,hn end
    return pos,pos,Vector3.new(0,1,0)
end

function U.ray(origin,dir,ig)
    ig=ig or (LP.Character and {LP.Character} or {})
    local r=Ray.new(origin,dir)
    return workspace:FindPartOnRayWithIgnoreList(r,ig)
end

function U.teleportForward(studs)
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local look=cam.CFrame.LookVector
    local flat=Vector3.new(look.X,0,look.Z)
    if flat.Magnitude<0.1 then flat=Vector3.new(0,0,-1) end
    flat=flat.Unit
    local start=hrp.CFrame.Position
    local target=start+flat*studs
    local safe=U.rayGround(target)
    local hRay=Ray.new(start+Vector3.new(0,2,0),flat*studs)
    local hHit,hPos=workspace:FindPartOnRayWithIgnoreList(hRay,{char})
    if hHit and (hPos-start).Magnitude<studs-1 then
        local d=(hPos-start).Magnitude-2
        if d<1 then d=1 end
        return U.rayGround(start+flat*d)
    end
    return safe
end

function U.fx(pos,color,size)
    color=color or Color3.fromRGB(255,220,0)
    size=size or 15
    local b=Instance.new("Part")
    b.Name="EM_FX"; b.Size=Vector3.new(1,1,1)
    b.Shape=Enum.PartType.Ball; b.Color=color
    b.Material=Enum.Material.Neon; b.Anchored=true
    b.CanCollide=false; b.CanQuery=false; b.CanTouch=false
    b.CFrame=CFrame.new(pos); b.Parent=workspace
    local l=Instance.new("PointLight")
    l.Color=color; l.Brightness=10; l.Range=size*1.5; l.Shadows=false
    l.Parent=b
    local a=Instance.new("Attachment"); a.Parent=b
    local e=Instance.new("ParticleEmitter")
    e.Texture="rbxasset://textures/particles/sparkles_main.dds"
    e.Color=ColorSequence.new(color); e.Rate=200
    e.Lifetime=NumberRange.new(0.5,1); e.Speed=NumberRange.new(3,8)
    e.Size=NumberSequence.new(0.5); e.LightEmission=1
    e.Parent=a
    TS:Create(b,TweenInfo.new(0.5),{Size=Vector3.new(size,size,size),Transparency=1}):Play()
    task.delay(0.6,function() if b and b.Parent then b:Destroy() end end)
end

function U.sound(parent)
    parent=parent or (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"))
    if not parent then return end
    local s=Instance.new("Sound")
    s.SoundId="rbxassetid://9114380053"; s.Volume=2; s.Parent=parent; s:Play()
    task.delay(2,function() if s and s.Parent then s:Destroy() end end)
end

function U.btn(parent,text,y,cb,color)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(0.9,0,0,42)
    b.Position=UDim2.new(0.05,0,0,y)
    b.BackgroundColor3=color or Color3.fromRGB(45,45,45)
    b.TextColor3=Color3.new(1,1,1); b.Font=Enum.Font.Gotham
    b.TextSize=15; b.Text=text; b.Parent=parent
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,6); c.Parent=b
    b.MouseButton1Click:Connect(function() pcall(cb,b) end)
    return b
end

function U.float(parent,text,size,pos,color,cb,drag)
    local b=Instance.new("TextButton")
    b.Size=size or UDim2.new(0,70,0,70)
    b.Position=pos or UDim2.new(0,10,0,130)
    b.BackgroundColor3=color or Color3.fromRGB(255,200,0)
    b.TextColor3=Color3.fromRGB(0,0,0); b.Font=Enum.Font.GothamBold
    b.TextSize=15; b.Text=text; b.Draggable=drag or false; b.Parent=parent
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(1,0); c.Parent=b
    b.MouseButton1Click:Connect(function() pcall(cb) end)
    return b
end

function U.getHRP(plr)
    plr=plr or LP
    local ch=plr.Character; if not ch then return nil end
    return ch:FindFirstChild("HumanoidRootPart")
end

function U.isTapOnGUI(x,y)
    if not C.gui then return false end
    local objs=LP.PlayerGui:GetGuiObjectsAtPosition(x,y)
    for _,g in pairs(objs) do
        if g:IsDescendantOf(C.gui) then return true end
    end
    return false
end


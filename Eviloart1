-- Все модули регистрируют свои функции в CTX.tapHandlers.
-- При тапе по экрану (не по GUI) они вызываются все.
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        local x, y = input.Position.X, input.Position.Y
        if U.isTapOnGUI(x, y) then return end
        for _, fn in ipairs(CTX.tapHandlers) do
            pcall(fn, x, y)
        end
    end
end)

